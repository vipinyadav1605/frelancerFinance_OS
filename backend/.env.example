# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL) - matches the `CREATE DATABASE` / `CREATE USER` commands
# you ran manually. See backend/README.md for the setup command.
DATABASE_URL=postgres://ffos_app:choose_a_strong_password_here@localhost:5432/freelancer_finance_os

# CORS - the frontend dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Razorpay Subscriptions (billing) - create a Plan first in the Razorpay
# Dashboard under Subscriptions > Plans, then paste its plan_id here. Leave
# blank to keep the Pro upgrade button showing a clear "not configured" error.
RAZORPAY_PRO_MONTHLY_PLAN_ID=

# Google Sign-In - create an OAuth 2.0 Client ID (Web application type) at
# https://console.cloud.google.com/apis/credentials. Must match the
# frontend's VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# Email (console backend prints emails to the terminal in dev - no SMTP needed yet).
# To send real emails (password reset, invoice sending, overdue reminders),
# switch to the SMTP backend with a free relay - e.g. Brevo
# (https://app.brevo.com, free tier: 300 emails/day, SMTP under
# Settings > SMTP & API) or Resend (https://resend.com, free tier: 100/day,
# SMTP under Domains > SMTP). Then set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp-relay.brevo.com          (or smtp.resend.com)
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=<your relay login>
#   EMAIL_HOST_PASSWORD=<your relay SMTP key>
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=<a verified sender address>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@freelancerfinanceos.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Error tracking (Sentry, free tier: 5k events/month) - create a project at
# https://sentry.io (choose "Django" as the platform) and paste its DSN here.
# Leave blank to disable entirely - no SDK init, no network calls.
SENTRY_DSN=
