# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL) - matches the `CREATE DATABASE` / `CREATE USER` commands
# you ran manually. See backend/README.md for the setup command.
DATABASE_URL=postgres://ffos_app:choose_a_strong_password_here@localhost:5432/freelancer_finance_os

# CORS - the frontend dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Email (console backend prints emails to the terminal in dev - no SMTP needed yet)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@freelancerfinanceos.local
