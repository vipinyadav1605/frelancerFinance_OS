# Copy this file to .env and adjust if your backend runs on a different port.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: only needed for "Sign in with Google". Create one at
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# "Web application" type, with this app's URL under Authorized JavaScript
# origins). Must match the backend's GOOGLE_OAUTH_CLIENT_ID. Leave blank to
# hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# Shown on the landing page's pricing section. Purely a display string - the
# real price lives in the Razorpay Plan you create for
# RAZORPAY_PRO_MONTHLY_PLAN_ID (backend .env). Keep these two in sync manually.
VITE_PRO_PLAN_PRICE_DISPLAY=₹299/month

# Error tracking (Sentry, free tier: 5k events/month) - create a project at
# https://sentry.io (platform: React) and paste its DSN here. Leave blank to
# disable entirely.
VITE_SENTRY_DSN=
